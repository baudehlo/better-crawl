{
  "name": "better-crawl",
  "version": "0.3.0",
  "description": "AI generates a crawler once — a self-tested, replayable Playwright or cheerio program — then runs it for near-zero cost, healing it when the site changes.",
  "keywords": [
    "crawling",
    "scraping",
    "playwright",
    "cheerio",
    "AI",
    "llm",
    "codegen",
    "zod"
  ],
  "homepage": "https://github.com/baudehlo/better-crawl#readme",
  "bugs": {
    "url": "https://github.com/baudehlo/better-crawl/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baudehlo/better-crawl.git"
  },
  "license": "MIT",
  "author": "Matt Sergeant",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "better-crawl": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "typecheck": "tsc --noEmit",
    "pretest": "tsdown",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "ai": "^6.0.0",
    "cheerio": "^1.0.0",
    "tough-cookie": "^5.0.0",
    "undici": "^8.10.1"
  },
  "peerDependencies": {
    "playwright": "^1.50.0",
    "zod": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^3.0.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "playwright": "^1.59.0",
    "tsdown": "^0.22.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "zod": "^4.3.0"
  }
}
